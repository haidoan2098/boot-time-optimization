[Unit]
Description=MotoCluster LVGL (fixed UI for boot time study)
# Start as early as possible: drop the implicit After=sysinit.target
# basic.target added by DefaultDependencies=yes, so the UI does not wait
# for unrelated services. Only the mount holding the binary is required;
# /dev/fb0 comes from the built-in display driver before init runs.
DefaultDependencies=no
RequiresMountsFor=/usr/bin

[Service]
Type=simple
ExecStart=/usr/bin/motocluster-lvgl
# [PHASE]/[KPI] lines go to the journal: journalctl -u motocluster-lvgl
StandardError=journal
Restart=no

[Install]
WantedBy=multi-user.target
